{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-mentor-open-courses",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  // learn.agentmentor.dev is the public home of the open-course library; the
  // marketing site (agentmentor.dev, Vercel) only links here — the two repos
  // deploy independently and must not share code.
  "routes": [
    { "pattern": "learn.agentmentor.dev", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
